{
  "hooks": [
    {
      "name": "auto-verify-file-references",
      "event": "post_tool_call",
      "matcher": {
        "tools": [
          "write_to_file",
          "replace_file_content",
          "multi_replace_file_content"
        ]
      },
      "action": {
        "command": "python3 skills/workforce-management/scripts/validate-references.py ./ --fix"
      }
    }
  ]
}
